{
  "name": "canvas-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "dev": "pnpm build && node scripts/dev.mjs",
    "bench": "pnpm build && node scripts/benchmark.mjs",
    "package": "pnpm build && node scripts/package-worker.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "1.0.0-rc.3",
    "@cloudflare/workers-types": "5.20261124.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "workerd": "1.20261124.1"
  }
}
